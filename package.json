{
  "name": "git-green-wave",
  "description": "Automatically commit to Github to keep your contribution history green",
  "version": "0.0.1",
  "author": "Steffen Kühne",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:br-data/webpack-longread-template.git"
  },
  "main": "index.js",
